# Copiar a .env.local. Local: valores de `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Se usa únicamente para enviar invitaciones (auth admin). Nunca en el cliente.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Pruebas de base de datos (opcional; por defecto el Postgres local de Supabase)
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
